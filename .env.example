# Lite storefront environment
# Stripe publishable key for Elements + server-side confirm (3DS) flow.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_

# Auth provider. MUST be 'backend' in every deployed build — without it the app
# silently ships "mock" Google auth and logs everyone in as user@gmail.com.
# 'mock' is only for local UI development with no backend running.
VITE_AUTH_PROVIDER=backend

# Auth API base URL — overrides VITE_API_URL for auth endpoints. Either a full
# URL ending in /api (e.g. https://apiv1.travioafrica.com/api) or a bare origin
# (https://apiv1.travioafrica.com — '/api' is appended automatically).
VITE_AUTH_API_BASE_URL=

# Expedition-Go-Backend API origin
VITE_API_URL=https://api.travioafrica.com

# Google One Tap sign-in client ID (must match the backend's GOOGLE_CLIENT_ID).
# Auto-shows Google One Tap on the sign-in page and exchanges the credential via
# POST /api/auth/google/onetap. When empty, sign-in falls back to the OAuth redirect flow.
VITE_GOOGLE_CLIENT_ID=

# TravioAfrica-Supplier platform origin. Approved suppliers are redirected here
# (to /auth/callback?accessToken=...&refreshToken=...) to log in securely.
VITE_SUPPLIER_PLATFORM_URL=https://supplier.travioafrica.com

# Google Maps JavaScript API key for the optional Google-enhanced booking
# features (the ETA/travel-time chip's Routes library). The booking-area pickup
# map itself renders with the keyless MapLibre + OpenFreeMap stack, then
# degrades to the Mapbox GL fallback and finally a text + Maps-link fallback —
# the Google key is not required for any of them.
VITE_GOOGLE_MAPS_API_KEY=

# Optional Google Maps Map ID (cloud-styled maps). Leave empty to use
# DEMO_MAP_ID, which already enables advanced markers.
VITE_GOOGLE_MAPS_MAP_ID=

# SerpApi private key for the booking pickup picker's "Search Google Maps"
# fallback (Google Maps search for Ghana places).
#
# SECURITY — SERVER-ONLY SECRET: although this uses the VITE_ naming for
# deployment-tooling consistency, it must NEVER reach the browser bundle. It
# is read only by the Vercel middleware (`middleware.ts`) and the Vite dev
# route via process.env / loadEnv. A build guard (server/noClientSerpKey.ts)
# fails the build if any client code references VITE_SERP_API_KEY or uses the
# bare `import.meta.env` object. `SERPAPI_API_KEY` is still accepted as a
# legacy alias. Get the key at https://serpapi.com/manage-api-key. Leave
# empty to disable the feature (the picker falls back to paste-a-link /
# manual options).
VITE_SERP_API_KEY=

