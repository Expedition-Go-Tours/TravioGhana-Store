# Lite storefront environment
# Stripe publishable key for Elements + server-side confirm (3DS) flow.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_

# Expedition-Go-Backend API origin
VITE_API_URL=https://api.travioafrica.com

# Google One Tap sign-in client ID (must match the backend's GOOGLE_CLIENT_ID).
# Auto-shows Google One Tap on the sign-in page and exchanges the credential via
# POST /api/auth/google/onetap. When empty, sign-in falls back to the OAuth redirect flow.
VITE_GOOGLE_CLIENT_ID=

# TravioAfrica-Supplier platform origin. Approved suppliers are redirected here
# (to /auth/callback?accessToken=...&refreshToken=...) to log in securely.
VITE_SUPPLIER_PLATFORM_URL=https://supplier.travioafrica.com

# Google Maps JavaScript API key for the booking-area pickup map. When set and
# valid (billing enabled on the Google Cloud project), the booking map renders
# with Google Maps; on any load/auth failure it automatically falls back to the
# free MapLibre + OSM raster tiles, then to a text + Google Maps link.
VITE_GOOGLE_MAPS_API_KEY=

# Optional Google Maps Map ID (cloud-styled maps). Leave empty to use
# DEMO_MAP_ID, which already enables the advanced marker pins.
VITE_GOOGLE_MAPS_MAP_ID=
