.env
# Node modules
node_modules/

# Environment variables (VERY IMPORTANT)

.env.local
.env.development.local
.env.test.local
.env.production.local
.vite 
.kiro
opencode.json

# Vercel CLI project link (contains org/project IDs) — created by `vercel link`
.vercel/

Expedition-Go-Backend-v2/
Expedition-Go-Backend/
Expedition-Go-Dashboard/
Expedition-GO-Frontend/
Expedition-Go-Lite/
TravioAfrica-Supplier/
TravioAfricaAdmin/

AUTH_SETUP.md
BEHAVIOUR_ANALYSIS.md
CAROUSEL_ANALYSIS.md
IMPLEMENTATION_SUMMARY.md
*.md
# The repo README is the one markdown file that must be tracked; the
# analysis notes above stay ignored by the blanket *.md rule.
!README.md
# Developer workflow docs that are intentionally tracked.
!docs/vercel-local-dev.md
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
.cursor/
.jsons/
# Build / temp files
dist/
build/
tmp/
temp/
reference/
public/assets/font 
# Generated by the copy-mapbox-worker Vite plugin (vite.config.ts) — regenerated
# on every dev/build from node_modules/mapbox-gl/dist/esm.
public/mapbox-gl/

# Generated by the copy-maplibre-worker Vite plugin (vite.config.ts) — regenerated
# on every dev/build from node_modules/maplibre-gl/dist under content-hashed names.
public/maplibre-gl/


# Generated on every `prebuild` by scripts/generate-story-pages.cjs and served
# by middleware.ts for crawlers — the same "generated, never hand-edited"
# treatment as public/mapbox-gl/ above.
public/stories/*.html

# Coverage
coverage/

# Cache
.cache/

# Optional: lock files (only ignore if team agrees)
# package-lock.json
# yarn.lock.